{
  "name": "foodbot-cloudflare-worker",
  "version": "1.0.0",
  "description": "Serverless Telegram Bot for Sharif Samad Dining on Cloudflare Workers with D1 and KV",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "init-db-local": "wrangler d1 execute foodbot-db --local --file=./schema.sql",
    "init-db-remote": "wrangler d1 execute foodbot-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "grammy": "^1.35.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
