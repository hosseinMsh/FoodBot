# ============================================================
# FoodBot Configuration (.env)
# ============================================================

# Platform: "telegram" or "bale"
PLATFORM=telegram

# Bot Token:
# - For Telegram: Get from @BotFather on Telegram
# - For Bale: Get from @BotFather on Bale (بله)
BOT_TOKEN=your_bot_token_here

# Optional: Override Bot API URLs (Leave empty for automatic defaults)
# Telegram default: https://api.telegram.org/bot
# Bale default:     https://tapi.bale.ai/bot
# BOT_API_BASE_URL=https://tapi.bale.ai/bot
# BOT_API_BASE_FILE_URL=https://tapi.bale.ai/file/bot

# Samad Dining System API (Default: Sharif Dining)
SAMAD_BASE_URL=https://setad.dining.sharif.edu/
SAMAD_BASIC_AUTH=Basic c2FtYWQtbW9iaWxlOnNhbWFkLW1vYmlsZS1zZWNyZXQ=

# Database Path
DATABASE_PATH=storage.db

# Optional default credentials (for single-user / testing)
# DEFAULT_USERNAME=
# DEFAULT_PASSWORD=

# Set to False if university server uses self-signed/internal SSL certificates
VERIFY_SSL=False

# Proxy configuration (needed for Telegram in Iran; typically not required for Bale)
# Examples: socks5://127.0.0.1:1080 or http://127.0.0.1:7890
PROXY_URL=
