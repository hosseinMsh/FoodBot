# Cloudflare Workers Local Development Environment Variables
# Copy this file to .dev.vars and fill in your values:
# cp .dev.vars.example .dev.vars

# Platform: "telegram" or "bale"
PLATFORM=telegram

# Bot token from Telegram (@BotFather) or Bale (@BotFather)
BOT_TOKEN=your_bot_token_here

# Optional: custom bot API endpoint (default: https://api.telegram.org for Telegram, https://tapi.bale.ai for Bale)
# BOT_API_ROOT=https://tapi.bale.ai

# Samad University Dining API
SAMAD_BASE_URL=https://setad.dining.sharif.edu/
SAMAD_BASIC_AUTH=Basic c2FtYWQtbW9iaWxlOnNhbWFkLW1vYmlsZS1zZWNyZXQ=

# Sharif Payment Gateway URL (Direct recharge)
PAY_SHARIF_URL=https://pay.sharif.ir
